# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud Database Connection (Optional - PostgreSQL / Cloud SQL / Vercel Postgres / Supabase / Neon)
# If provided, calendar context data persists automatically into PostgreSQL.
# Example format: postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""
POSTGRES_URL=""
